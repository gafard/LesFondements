  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloud": "opennextjs-cloudflare build",
    "build:sites": "npm run build:cloud && ./scripts/stage-sites-build.sh",
    "preview:cloud": "opennextjs-cloudflare preview",
    "start": "next start",
    "lint": "eslint",
    "test:content": "node scripts/verifier-contenu.mjs",
    "etudes:importer": "python3 scripts/importer-etudes.py ../formation-biblique-app/data public/etudes",
