{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parcours",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Les témoignages audio. Un document Firestore plafonne à 1 Mio et l'audio
  // y voyageait en base64 : au-delà d'environ trois minutes, l'écriture était
  // refusée et le témoignage ne quittait jamais l'appareil de son auteur.
  // R2 sert dix gigaoctets et sa bande passante sortante gratuitement.
  "r2_buckets": [
    {
      "binding": "TEMOIGNAGES",
      "bucket_name": "lesfondements-temoignages"
    },
    // Les passages lus à la demande. Un même verset se disait une fois par
    // appareil : le cache ne vivait que dans le navigateur, et ElevenLabs
    // refacturait le même son à chaque nouveau visiteur. Gravé ici, il n'est
    // payé qu'une fois pour tout le monde.
    {
      "binding": "VOIX",
      "bucket_name": "lesfondements-voix"
    }
  ]
}
