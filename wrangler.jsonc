{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parcours",
  // Enveloppe le worker d'OpenNext pour lui ajouter `scheduled()`, dont il
  // a besoin pour que le déclencheur cron trouve quelqu'un.
  "main": "worker-entree.mjs",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Les témoignages audio. Un document Firestore plafonne à 1 Mio et l'audio
  // y voyageait en base64 : au-delà d'environ trois minutes, l'écriture était
  // refusée et le témoignage ne quittait jamais l'appareil de son auteur.
  // R2 sert dix gigaoctets et sa bande passante sortante gratuitement.
  // Les abonnements aux rappels. Ils ne vivaient nulle part : la route
  // d'abonnement répondait « persisted: false » et aucune notification
  // programmée ne pouvait donc partir.
  "kv_namespaces": [
    {
      "binding": "RAPPELS",
      "id": "cf3ce09265a54d079d6d39aad94c48b1"
    }
  ],
  // L'ordonnanceur : chaque quart d'heure, le worker regarde qui doit être
  // réveillé. Les heures choisies par les gens sont locales — un passage au
  // quart d'heure suffit à les servir toutes.
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "r2_buckets": [
    {
      "binding": "TEMOIGNAGES",
      "bucket_name": "lesfondements-temoignages"
    },
    // Les passages lus à la demande. Un même verset se disait une fois par
    // appareil : le cache ne vivait que dans le navigateur, et ElevenLabs
    // refacturait le même son à chaque nouveau visiteur. Gravé ici, il n'est
    // payé qu'une fois pour tout le monde.
    {
      "binding": "VOIX",
      "bucket_name": "lesfondements-voix"
    }
  ]
}
