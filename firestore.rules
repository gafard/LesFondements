rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Les sessions antérieures à la remise à zéro ne peuvent recréer les données supprimées.
    function connecte() {
      return request.auth != null && request.auth.token.auth_time >= 1788626251;
    }
    function moi() { return request.auth.uid; }

    function estInscrit(groupId) {
      return connecte()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(moi()));
    }

    function estMembre(groupId) {
      return estInscrit(groupId)
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(moi())).data.status == 'actif';
    }

    function estAnimateur(groupId) {
      return estMembre(groupId)
        && get(/databases/$(database)/documents/groups/$(groupId)/members/$(moi())).data.role in ['animateur', 'co_animateur'];
    }

    function estCreateur(groupId) {
      return connecte()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && get(/databases/$(database)/documents/groups/$(groupId)).data.leaderId == moi();
    }

    function ajouteMoi(apres, avant) {
      return apres is list
        && avant is list
        && apres.size() == avant.size() + 1
        && apres.toSet().size() == apres.size()
        && avant.toSet().size() == avant.size()
        && apres.hasAll(avant)
        && apres.removeAll(avant).hasOnly([moi()]);
    }

    function retireMoi(apres, avant) {
      return apres is list
        && avant is list
        && apres.size() + 1 == avant.size()
        && apres.toSet().size() == apres.size()
        && avant.toSet().size() == avant.size()
        && avant.hasAll(apres)
        && avant.removeAll(apres).hasOnly([moi()]);
    }

    function listePersonnelleOuInchangee(apres, avant) {
      return apres == avant || ajouteMoi(apres, avant) || retireMoi(apres, avant);
    }

    function annuaireValide() {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'description', 'inviteCode', 'visibility', 'capacity',
          'membersCount', 'leaderId', 'leaderName', 'place', 'meeting',
          'language', 'createdAt', 'currentStep', 'stepPhase', 'stepOpenedAt',
          'closedSteps', 'completedAt', 'archived', 'demo'
        ])
        && request.resource.data.id is string
        && request.resource.data.inviteCode == ''
        && request.resource.data.leaderId == ''
        && request.resource.data.place is map
        && request.resource.data.place.keys().hasOnly([
          'lat', 'lng', 'label', 'city', 'region', 'country', 'countryCode', 'precise'
        ])
        && request.resource.data.place.precise == false
        && request.resource.data.meeting is map
        && request.resource.data.meeting.keys().hasOnly([
          'mode', 'rhythm', 'weekday', 'time', 'timezone'
        ]);
    }

    function ajoutReponseValide() {
      let avant = resource.data.get('replies', []);
      let apres = request.resource.data.replies;
      let ajout = apres.removeAll(avant);
      return avant is list
        && apres is list
        && avant.size() < 20
        && apres.size() == avant.size() + 1
        && apres.hasAll(avant)
        && ajout.size() == 1
        && ajout[0] is map
        && ajout[0].keys().hasOnly(['id', 'authorId', 'authorName', 'content', 'createdAt'])
        && ajout[0].authorId == moi()
        && ajout[0].content is string
        && ajout[0].content.size() > 0
        && ajout[0].content.size() <= 200;
    }

    function sessionPlanifieeValide(groupId, sessionId) {
      return request.resource.data.keys().hasOnly([
          'id', 'groupId', 'step', 'scheduledAt', 'status', 'liveStage', 'attendance'
        ])
        && request.resource.data.id == sessionId
        && request.resource.data.groupId == groupId
        && request.resource.data.step == get(/databases/$(database)/documents/groups/$(groupId)).data.currentStep
        && request.resource.data.status == 'planifiee'
        && request.resource.data.liveStage == 0
        && request.resource.data.scheduledAt is int
        && request.resource.data.attendance is map
        && request.resource.data.attendance.size() == 0;
    }

    match /profiles/{userId} {
      allow read, write: if connecte() && moi() == userId;
    }

    // Annuaire expurgé : ville approximative et horaire, sans adresse, lien
    // visio, code d'invitation ni identifiant privé de l'animateur.
    match /groupDirectory/{groupId} {
      allow read: if connecte();
      allow create, update: if (estCreateur(groupId) || estAnimateur(groupId))
        && request.resource.data.id == groupId
        && annuaireValide();
      allow delete: if estCreateur(groupId) || estAnimateur(groupId);
    }

    // Résolution d'un code d'invitation vers un identifiant de groupe. Le
    // document ne contient aucune donnée personnelle.
    match /groupInvites/{code} {
      allow read: if connecte();
      allow create, update: if request.resource.data.keys().hasOnly(['groupId', 'code', 'updatedAt'])
        && request.resource.data.code == code
        && request.resource.data.groupId is string
        && (estCreateur(request.resource.data.groupId)
          || estAnimateur(request.resource.data.groupId));
      allow delete: if estAnimateur(resource.data.groupId);
    }

    match /groups/{groupId} {
      // Le document complet contient l'adresse et le lien de réunion : seuls
      // les membres approuvés peuvent le consulter.
      allow read: if estMembre(groupId);
      allow create: if connecte()
        && request.resource.data.id == groupId
        && request.resource.data.leaderId == moi()
        && request.resource.data.membersCount == 1
        && request.resource.data.currentStep == 1
        && request.resource.data.closedSteps.size() == 0
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'description', 'inviteCode', 'visibility', 'capacity',
          'membersCount', 'leaderId', 'leaderName', 'place', 'meeting',
          'language', 'createdAt', 'currentStep', 'stepPhase', 'stepOpenedAt',
          'closedSteps', 'completedAt', 'archived', 'demo'
        ]);
      allow update: if (estAnimateur(groupId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.leaderId == resource.data.leaderId
          && request.resource.data.createdAt == resource.data.createdAt)
        // Un membre qui s'en va décrémente le compteur. Il ne peut toucher
        // qu'à ce champ, d'une seule unité, sans jamais passer sous zéro.
        || (estMembre(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membersCount'])
          && request.resource.data.membersCount == resource.data.membersCount - 1
          && request.resource.data.membersCount >= 0);
      allow delete: if estAnimateur(groupId);

      match /members/{memberId} {
        allow read: if connecte() && (moi() == memberId || estMembre(groupId));
        allow create: if connecte()
          && moi() == memberId
          && request.resource.data.uid == moi()
          && request.resource.data.groupId == groupId
          && (
            (get(/databases/$(database)/documents/groups/$(groupId)).data.leaderId == moi()
              && request.resource.data.role == 'animateur'
              && request.resource.data.status == 'actif')
            || (request.resource.data.role == 'membre'
              && request.resource.data.status == 'en_attente')
          );
        // La date d'entrée ne se réécrit pas — sauf à l'admission, qui est
        // justement le moment où elle prend son sens. Sans cette exception,
        // l'animateur ne pouvait accueillir personne : l'application date
        // l'entrée en accueillant, et l'écriture était refusée. La demande
        // repassait alors en attente au rechargement suivant.
        allow update: if (estAnimateur(groupId)
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.groupId == resource.data.groupId
            && (request.resource.data.joinedAt == resource.data.joinedAt
              || (resource.data.status != 'actif'
                && request.resource.data.status == 'actif')))
          || (connecte()
            && moi() == memberId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['preparedSteps', 'personalStep', 'nextAttendance', 'lastSeenAt']))
          // Corriger son propre nom. À l'inscription par e-mail, le nom est
          // déduit de l'adresse — « jean.dupont92 » — et se retrouvait affiché
          // au groupe sans que personne puisse le changer. On ne touche ici
          // qu'à sa propre ligne, et à rien d'autre qu'à son identité.
          || (connecte()
            && moi() == memberId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'photoURL'])
            && request.resource.data.displayName is string
            && request.resource.data.displayName.size() > 0
            && request.resource.data.displayName.size() <= 60)
          // Partir de son propre chef. Uniquement vers « parti » : se poser
          // soi-même en « actif » reviendrait à s'auto-approuver.
          || (connecte()
            && moi() == memberId
            && request.resource.data.status == 'parti'
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              || (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'displayName', 'email', 'photoURL'])
                && request.resource.data.displayName == 'Compte supprimé'
                && request.resource.data.email == null
                && request.resource.data.photoURL == null)
            ));
        allow delete: if estAnimateur(groupId);
      }

      // Les attelages de prière : qui veille sur qui. Le document ne porte
      // que des identifiants et une date — rien de ce qu'on pourrait dire
      // d'une personne. C'est voulu, et les règles ne doivent pas laisser
      // ajouter autre chose.
      match /binomes/{binomeId} {
        allow read: if estMembre(groupId);
        allow create: if estAnimateur(groupId)
          && request.resource.data.keys().hasOnly(['id', 'groupId', 'membres', 'creeLe', 'creePar'])
          && request.resource.data.membres.size() >= 2
          && request.resource.data.membres.size() <= 3;
        allow delete: if estAnimateur(groupId);
        // Un attelage ne se modifie pas : on le défait et on en refait un.
        allow update: if false;
      }

      match /sessions/{sessionId} {
        allow read: if estMembre(groupId);
        allow create: if estMembre(groupId) && sessionPlanifieeValide(groupId, sessionId);
        allow update: if (estAnimateur(groupId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.groupId == resource.data.groupId
            && request.resource.data.step == resource.data.step)
          || (estMembre(groupId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendance'])
            && request.resource.data.attendance.diff(resource.data.attendance).affectedKeys().hasOnly([moi()])
            && request.resource.data.attendance[moi()] in ['presentiel', 'ligne', 'absent']);
        allow delete: if estAnimateur(groupId);
      }

      match /posts/{postId} {
        allow read: if estMembre(groupId);
        allow create: if estMembre(groupId)
          && request.resource.data.authorId == moi()
          && request.resource.data.groupId == groupId
          && request.resource.data.id == postId
          && request.resource.data.keys().hasOnly([
            'id', 'groupId', 'authorId', 'authorName', 'kind', 'step',
            'questionId', 'reference', 'content', 'createdAt', 'prayedBy',
            'amenBy', 'answered', 'answeredAt', 'replies'
          ])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 4000
          && request.resource.data.prayedBy.size() == 0
          && request.resource.data.amenBy.size() == 0
          && request.resource.data.get('replies', []).size() == 0;
        allow update: if estMembre(groupId) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayedBy', 'amenBy'])
            && listePersonnelleOuInchangee(request.resource.data.prayedBy, resource.data.prayedBy)
            && listePersonnelleOuInchangee(request.resource.data.amenBy, resource.data.amenBy))
          // Répondre brièvement. Seul ce champ bouge : le message d'origine
          // ne peut pas être réécrit au passage.
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replies'])
            && ajoutReponseValide())
          || ((resource.data.authorId == moi() || estAnimateur(groupId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answered', 'answeredAt']))
        );
        allow delete: if estMembre(groupId)
          && (resource.data.authorId == moi() || estAnimateur(groupId));
      }
    }

    match /invitations/{inviteId} {
      allow read: if connecte()
        && (request.auth.token.email == resource.data.email
          || estMembre(resource.data.groupId));
      allow create: if connecte()
        && request.resource.data.invitedBy == moi()
        && estMembre(request.resource.data.groupId)
        && request.resource.data.status == 'envoye'
        && request.resource.data.keys().hasOnly([
          'id', 'groupId', 'email', 'invitedBy', 'invitedByName', 'createdAt', 'status'
        ]);
      allow update: if connecte()
        && (request.auth.token.email == resource.data.email
          || estAnimateur(resource.data.groupId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['envoye', 'accepte', 'expire'];
      allow delete: if connecte() && estAnimateur(resource.data.groupId);
    }

    match /users/{userId} {
      allow read, write: if connecte() && moi() == userId;
      match /progress/{ficheId} {
        allow read, write: if connecte() && moi() == userId;
      }
      match /journal/{entryId} {
        allow read, write: if connecte() && moi() == userId;
      }
      match /memory/{documentId} {
        allow read, write: if connecte() && moi() == userId;
      }
    }

    // Témoignages du tableau de liège communautaire
    match /temoignages/{temoignageId} {
      // Le mur est la vitrine du parcours : il se lit sans compte.
      allow read: if true;

      // On ne dépose que sous son propre nom. Sans cette condition, le
      // témoignage de quelqu'un pouvait être signé par un autre.
      allow create: if connecte()
        && request.resource.data.auteurId == moi()
        && request.resource.data.id == temoignageId
        && request.resource.data.keys().hasOnly([
          'id', 'auteur', 'auteurId', 'ficheId', 'texte', 'audioUrl', 'amens',
          'amensVotants', 'date', 'couleur', 'attache', 'rotation'
        ])
        && request.resource.data.texte is string
        && request.resource.data.texte.size() <= 5000
        && (request.resource.data.audioUrl == null
          || (request.resource.data.audioUrl is string
            && request.resource.data.audioUrl.size() <= 700000))
        && request.resource.data.amens == 1
        && request.resource.data.amensVotants == [moi()];

      allow update: if connecte() && (
        // Son auteur corrige son texte.
        (resource.data.auteurId == moi()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'texte', 'audioUrl', 'ficheId', 'couleur', 'attache', 'rotation'
          ]))
        // Ou quelqu'un dit « amen » : seuls ces deux champs bougent, et on
        // ne peut s'ajouter ou se retirer que soi-même de la liste. Sans
        // cette borne, un « amen » pouvait réécrire tout le document.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amens', 'amensVotants'])
          && (
            (ajouteMoi(request.resource.data.amensVotants, resource.data.amensVotants)
              && request.resource.data.amens == resource.data.amens + 1)
            || (retireMoi(request.resource.data.amensVotants, resource.data.amensVotants)
              && request.resource.data.amens == resource.data.amens - 1
              && request.resource.data.amens >= 0)
          )
        )
      );

      // On ne supprime que le sien. La règle précédente disait
      // « connecte() || true » : le « || true » annulait la vérification, et
      // n'importe qui — même sans compte — pouvait vider le mur.
      allow delete: if connecte() && resource.data.auteurId == moi();
    }

    // Retours d'expérience, besoins et messages envoyés à l'équipe
    match /retours/{retourId} {
      allow create: if request.resource.data.keys().hasOnly([
          'uid', 'nom', 'email', 'categorie', 'message', 'date', 'dateIso'
        ])
        && request.resource.data.nom is string
        && request.resource.data.nom.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.categorie in ['suggestion', 'temoignage', 'aide', 'theologie']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && ((connecte() && request.resource.data.uid == moi())
          || (!connecte() && request.resource.data.uid == null));
      // Les messages sont une boîte de dépôt, pas un annuaire lisible depuis
      // le navigateur. Leur consultation passera par un outil administrateur.
      allow read, update, delete: if false;
    }

    // Boîte de signalement : le navigateur peut déposer, jamais consulter.
    // Le traitement s'effectue avec un accès administrateur hors application.
    match /moderationReports/{reportId} {
      allow create: if connecte()
        && request.resource.data.keys().hasOnly([
          'id', 'reporterUid', 'targetType', 'targetId', 'reason',
          'comment', 'status', 'createdAt'
        ])
        && request.resource.data.id == reportId
        && request.resource.data.reporterUid == moi()
        && request.resource.data.targetType in ['temoignage', 'message_groupe', 'reponse']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 180
        && request.resource.data.reason in ['dangereux', 'haine', 'harcelement', 'spam', 'vie_privee', 'autre']
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        && request.resource.data.status == 'en_attente'
        && request.resource.data.createdAt is int;
      allow read, update, delete: if false;
    }

    // Entonnoir minimal et consenti : aucun UID, groupe, écran ou texte libre.
    match /usageEvents/{eventId} {
      allow create: if connecte()
        && request.resource.data.keys().hasOnly([
          'id', 'installationId', 'event', 'day', 'createdAt', 'expiresAt', 'version'
        ])
        && request.resource.data.id == eventId
        && request.resource.data.installationId is string
        && request.resource.data.installationId.size() >= 20
        && request.resource.data.installationId.size() <= 80
        && request.resource.data.event in [
          'installation', 'fiche_1', 'groupe', 'preparation', 'rituel', 'rencontre',
          'retention_j1', 'retention_j7', 'retention_j30'
        ]
        && request.resource.data.day is string
        && request.resource.data.day.size() == 10
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.expiresAt <= request.resource.data.createdAt + 7862400000
        && request.resource.data.version is string
        && request.resource.data.version.size() <= 40;
      allow read, update, delete: if false;
    }
  }
}
